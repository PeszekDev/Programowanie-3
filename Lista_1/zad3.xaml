<Window x:Class="Lista_1.zad3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista_1"
        mc:Ignorable="d"
        Title="Zadanie 3 - DockPanel" Height="300" Width="400">

    <DockPanel LastChildFill="True">
        <Button Content="Bottom" DockPanel.Dock="Bottom" Height="30"/>

        <Button Content="Left" DockPanel.Dock="Left" Width="45"/>
        <Button Content="Right" DockPanel.Dock="Right" Width="45"/>

        <Button Content="Top" DockPanel.Dock="Top" Height="65" Background="Red"/>
        <Button Content="Top2" DockPanel.Dock="Top" Height="90" Width="115" Margin="18,0,0,0" Background="Green"/>

        <Button Content="Right2" DockPanel.Dock="Right" Width="50" Height="65" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        <Button Content="Right3" DockPanel.Dock="Right" Width="50" Height="65" VerticalAlignment="Bottom" Margin="0,0,0,12"/>

        <Button Content="Top3" DockPanel.Dock="Top" Height="30" VerticalAlignment="Bottom" Background="Blue" Foreground="White"/>

        <Button Content="Fill"/>
    </DockPanel>
</Window>