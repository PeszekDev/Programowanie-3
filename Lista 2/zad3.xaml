<Window x:Class="Lista_2.zad3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gracz 1" Height="520" Width="860"
        WindowStartupLocation="Manual" Left="0" Top="100">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Path=Status}" FontSize="18"
                   HorizontalAlignment="Center" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Moje statki (Gracz 1)" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Strzały w przeciwnika" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

        <Grid x:Name="MyGrid" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <Grid x:Name="EnemyGrid" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <Button x:Name="BtnReady" Grid.Row="3" Grid.Column="0" Content="Gotowe" Width="100" Margin="5"
                HorizontalAlignment="Left" Click="BtnReady_Click"/>
    </Grid>
</Window>
