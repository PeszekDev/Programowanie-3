<Window x:Class="Lista_2.zad3_1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lista_2"
        Title="Gracz 2" Height="520" Width="860" WindowStartupLocation="Manual">

    <Window.Resources>
        <local:TurnColor x:Key="TurnColor"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Moje statki (Gracz 2)" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Strzały w przeciwnika" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
        <UniformGrid x:Name="MyGrid" Grid.Row="1" Grid.Column="0" Rows="10" Columns="10" Margin="5"/>
        <UniformGrid x:Name="EnemyGrid" Grid.Row="1" Grid.Column="1" Rows="10" Columns="10" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="{Binding Status}" 
                   Foreground="{Binding Turn, Converter={StaticResource TurnColor}}"
                   FontWeight="SemiBold"
                   FontSize="13" VerticalAlignment="Center" Margin="5"/>
        <Button x:Name="BtnReady" Grid.Row="2" Grid.Column="1" Content="Gotowe" Width="100" HorizontalAlignment="Right" Click="BtnReady_Click" Margin="5" Padding="5"/>
    </Grid>
</Window>