<Window x:Class="Lista_2.Zad2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lista_2"
        Title="Kółko i krzyżyk" Height="450" Width="800">
    <Window.DataContext>
        <local:TicTacToe/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Path=Status}" FontSize="20"
                   HorizontalAlignment="Center" Margin="5"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Tag="0" FontSize="40" Content="{Binding Path=Cells[0]}" Click="Button_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Tag="1" FontSize="40" Content="{Binding Path=Cells[1]}" Click="Button_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Tag="2" FontSize="40" Content="{Binding Path=Cells[2]}" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="0" Tag="3" FontSize="40" Content="{Binding Path=Cells[3]}" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Tag="4" FontSize="40" Content="{Binding Path=Cells[4]}" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Tag="5" FontSize="40" Content="{Binding Path=Cells[5]}" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="0" Tag="6" FontSize="40" Content="{Binding Path=Cells[6]}" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Tag="7" FontSize="40" Content="{Binding Path=Cells[7]}" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Tag="8" FontSize="40" Content="{Binding Path=Cells[8]}" Click="Button_Click"/>
        </Grid>

        <Button Grid.Row="2" Content="Nowa gra" Width="100" Margin="5" Click="NewGame_Click"/>
    </Grid>
</Window>
