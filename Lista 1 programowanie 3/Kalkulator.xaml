<Window x:Class="Lista_1_Programowanie_3.Kalkulator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista_1_Programowanie_3"
        mc:Ignorable="d"
        Title="Kalkulator" Height="450" Width="800">

    <Grid Width="300" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        
        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" 
                 FontSize="24" TextAlignment="Right" VerticalContentAlignment="Center" 
                 Margin="3" IsReadOnly="True" Text="0" />

       
        <Button Grid.Row="1" Grid.Column="0" Content="7" Margin="3" FontSize="18"/>
        <Button Grid.Row="1" Grid.Column="1" Content="8" Margin="3" FontSize="18"/>
        <Button Grid.Row="1" Grid.Column="2" Content="9" Margin="3" FontSize="18"/>
        <Button Grid.Row="1" Grid.Column="3" Content="/" Margin="3" FontSize="18"/>

        <Button Grid.Row="2" Grid.Column="0" Content="4" Margin="3" FontSize="18"/>
        <Button Grid.Row="2" Grid.Column="1" Content="5" Margin="3" FontSize="18"/>
        <Button Grid.Row="2" Grid.Column="2" Content="6" Margin="3" FontSize="18"/>
        <Button Grid.Row="2" Grid.Column="3" Content="*" Margin="3" FontSize="18"/>

        
        <Button Grid.Row="3" Grid.Column="0" Content="1" Margin="3" FontSize="18"/>
        <Button Grid.Row="3" Grid.Column="1" Content="2" Margin="3" FontSize="18"/>
        <Button Grid.Row="3" Grid.Column="2" Content="3" Margin="3" FontSize="18"/>
        <Button Grid.Row="3" Grid.Column="3" Content="-" Margin="3" FontSize="18"/>

       
        <Button Grid.Row="4" Grid.Column="0" Content="C" Margin="3" FontSize="18"/>
        <Button Grid.Row="4" Grid.Column="1" Content="0" Margin="3" FontSize="18"/>
        <Button Grid.Row="4" Grid.Column="2" Content="=" Margin="3" FontSize="18"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Margin="3" FontSize="18"/>
    </Grid>

</Window>
