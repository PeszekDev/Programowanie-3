<Window x:Class="zad2_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2_wpf"
        mc:Ignorable="d"
        Title="Zadanie 2 - Formularz Studenta" Height="450" Width="450">

    <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Formularz dodawania studenta" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Imię:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Height="28" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="Nazwisko:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Height="28" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="Data urodzenia:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <DatePicker Height="28" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="Semestr:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <ComboBox Height="28" VerticalContentAlignment="Center" Margin="0,0,0,20" SelectedIndex="0">
            <ComboBoxItem Content="Semestr 1"/>
            <ComboBoxItem Content="Semestr 2"/>
            <ComboBoxItem Content="Semestr 3"/>
            <ComboBoxItem Content="Semestr 4"/>
            <ComboBoxItem Content="Semestr 5"/>
            <ComboBoxItem Content="Semestr 6"/>
            <ComboBoxItem Content="Semestr 7"/>
        </ComboBox>

        <Button Content="Zapisz studenta w bazie" Height="34" FontWeight="Bold"/>
    </StackPanel>
</Window>